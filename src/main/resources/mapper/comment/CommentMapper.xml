<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.spring.stockflow.mapper.comment.CommentMapper">
    <insert id="addComment">
        INSERT INTO notice_comment
        (
            notice_id,
            reg_user_id,
            content
        )
        VALUES
        (
            #{noticeId},
            #{regUserId},
            #{content}
        )
    </insert>
</mapper>